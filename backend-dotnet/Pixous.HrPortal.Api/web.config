<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for the ASP.NET Core backend.

  The ASP.NET Core Module rewrites this file's handler section on publish, so
  the parts worth keeping here are the ones it does not touch: the request
  limits, the headers, the WebSocket switch and the environment.

  NOTHING SECRET BELONGS IN THIS FILE. It is committed. The connection string
  and the JWT signing key are supplied per machine, which the <environmentVariables>
  section below explains.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
        In-process. Out-of-process adds a loopback hop to every request, and the
        only reason to prefer it is a hosting model this application does not
        use.

        stdout logging is off by default: it writes an unbounded file, and the
        application's own logging already goes where it is wanted. Turn it on
        only while diagnosing a startup failure, and turn it off again — a
        forgotten stdout log is how a disk fills up months later.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\Pixous.HrPortal.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

          <!--
            The two settings the application refuses to start without are
            DELIBERATELY ABSENT here:

              ConnectionStrings__HrPortal
              App__Jwt__Secret

            Both are secrets and this file is committed. Set them on the
            application pool instead (IIS Manager → the site → Configuration
            Editor → system.webServer/aspNetCore → environmentVariables), or as
            machine environment variables, so they never enter source control.

            App__Jwt__Secret must be at least 32 bytes and must MATCH the Spring
            backend's APP_JWT_SECRET for as long as both run side by side —
            tokens issued by one are otherwise rejected by the other. The
            repository's own deploy/pre-deploy.sh enforces the same 32-byte
            minimum.
          -->
        </environmentVariables>
      </aspNetCore>

      <security>
        <requestFiltering>
          <!--
            26,214,400 bytes = 25 MB, matching
            spring.servlet.multipart.max-request-size in application.properties.

            Note the two Spring files disagree: application.yml says 10GB and
            application.properties says 10MB per file / 25MB per request.
            Properties wins in Spring Boot, so 25MB is the limit that is actually
            in force, and it is the one reproduced here.

            IIS refuses a larger body before the application ever sees it, so
            this and the Kestrel/IIS limits in Program.cs have to agree — or an
            upload fails with an IIS error page instead of the portal's own
            message.
          -->
          <requestLimits maxAllowedContentLength="26214400" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <!--
            IIS advertises itself by default; there is no reason to tell the
            internet which server and version is running.
          -->
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>

      <!--
        WebSockets, for the STOMP-over-SockJS endpoint at /ws.

        Off by default in IIS, and the failure is a quiet one: SockJS negotiates
        the websocket transport first, and without this the upgrade is refused
        and the client falls back — except that the polling fallbacks are not
        implemented here (see REALTIME.md), so real-time simply stops working
        while every HTTP request keeps succeeding. Notifications, presence and
        chat go silent and nothing looks broken.

        The Windows feature has to be installed as well (Web-WebSockets); this
        only enables it for the site.
      -->
      <webSocket enabled="true" pingInterval="00:00:10" />
    </system.webServer>
  </location>
</configuration>
