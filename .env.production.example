# Copy this file to ".env" next to docker-compose.prod.yml and fill it in.
#   cp .env.production.example .env
# NEVER commit the real .env (it is git-ignored).

# --- Database ---
# TWO CHOICES. Pick one and delete the other, or the app connects to the wrong one.
#
# (A) THE HOSTED DATABASE — the one the portal's real data is in. Choose this and
#     do NOT start the mysql container: there is nothing for it to do, and running
#     it alongside is how people end up looking at an empty portal and thinking
#     the data is gone.
#
#     DB_PARAMS is spelled out here on purpose. The default includes
#     createDatabaseIfNotExist, which asks the server to CREATE DATABASE on every
#     connect; a hosting account is not granted that, so the app would refuse to
#     start against a database that already exists and is perfectly healthy.
#
#     DB_POOL_MAX matters too. This account allows 20 connections in TOTAL, across
#     everything that uses it. Six leaves room for a restart that briefly runs two
#     copies, and for whatever else is connected.
DB_HOST=mysql1002.site4now.net
DB_PORT=3306
DB_NAME=db_ab2fe4_ems
DB_USER=ab2fe4_ems
DB_PASSWORD=
DB_PARAMS=useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_POOL_MAX=6
DB_POOL_MIN=1
#
# (B) A DATABASE OF OUR OWN, in the mysql container next to the backend. Empty on
#     first start; load a dump into it with deploy/local-restore.ps1.
# MYSQL_ROOT_PASSWORD=generate-one:  openssl rand -base64 24
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=hr_portal
# DB_USER=hruser
# DB_PASSWORD=generate-one-too

# --- Cache (Redis) ---
# Optional. With Redis, master data and settings are read once instead of on every
# page load, which matters most against the hosted database above because it is
# the connections that are scarce. Without it the backend caches in its own
# memory and logs that it did — nothing breaks either way.
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=
# CACHE_ENABLED=true

# --- Backend security ---
# Generate:  openssl rand -base64 48   (must be 32+ chars)
APP_JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# With the Nginx same-origin setup CORS is not actually exercised, but set it
# to your real public URL anyway (comma-separated, no spaces, no trailing /):
APP_CORS_ALLOWED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# --- Optional ---
TWILIO_ENABLED=false
# JAVA_OPTS=-Xms256m -Xmx768m

# --- Hikvision biometric attendance (optional) ---
#
# Reading punches from a Hik-Connect for Teams terminal. Leave HIKVISION_ENABLED
# false and the portal behaves exactly as it did before -- attendance is punched
# in the app and nothing here runs.
#
# The app key and secret come from Hikvision technical support against your
# Hik-Connect for Teams account; they cannot be generated locally. They are the
# whole of the integration's authority -- anybody holding them can read every
# person and every punch on the account -- so they live here, in a file git
# ignores, and never in the repository.
HIKVISION_ENABLED=false
# Regional, and the wrong one simply fails to authenticate.
# India / Singapore: https://isgp.hikcentralconnect.com
# Europe: https://ieu.hikcentralconnect.com
# North America: https://ius.hikcentralconnect.com
HIKVISION_BASE_URL=https://isgp.hikcentralconnect.com
HIKVISION_APP_KEY=
HIKVISION_SECRET_KEY=
# Signs the pushes Hikvision sends, so a stranger who finds the public callback
# URL cannot post a punch. 8-32 letters and digits, your own choice.
#
# Optional: leave it empty and both ends fall back to the secret key above,
# which is what Hikvision itself does. Setting it means the secret key can be
# rotated without re-registering the webhook.
HIKVISION_WEBHOOK_SECRET=
