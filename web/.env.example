# Frontend environment variables (Vite — must be prefixed with VITE_).

# Base URL of the backend API.
# - Local dev: leave EMPTY. The Vite dev proxy forwards /api and /ws to
#   http://localhost:7060 automatically.
# - Production (Render): set this to your deployed backend URL, e.g.
#   VITE_API_URL=https://pixous-ems-backend.onrender.com
VITE_API_URL=
