# ==============================================================================
# Pixous HR Portal - Environment Configuration Template (.env.example)
# Copy this file to ".env" and fill in your local or hosted credentials.
# NEVER commit the real .env to source control!
# ==============================================================================

# --- Database Connection (MySQL) ---
# Hostname or IPv4 of your MySQL server (e.g., localhost or mysql1002.site4now.net)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_ab2fe4_ems
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_POOL_MAX=6
DB_POOL_MIN=1

# Optional read-only credentials (for analytics / reporting)
# DB_RO_USER=
# DB_RO_PASSWORD=
# DB_ALLOW_WRITES=1

# --- Security / JWT Configuration ---
# Must be at least 32 characters (HMAC-SHA256 required)
# Generate via: openssl rand -base64 48
APP_JWT_SECRET=your_long_random_jwt_secret_must_be_at_least_32_characters_long

# --- CORS Allowed Origins ---
# Comma-separated list of origins permitted to call the backend API
APP_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000

# --- Biometric Terminal Integration (Hikvision - Optional) ---
HIKVISION_ENABLED=false
HIKVISION_BASE_URL=https://isgp.hikcentralconnect.com
HIKVISION_APP_KEY=
HIKVISION_SECRET_KEY=
HIKVISION_WEBHOOK_SECRET=

# --- Notifications / SMS (Optional) ---
FAST2SMS_API_KEY=
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
