analytics-service/
mobile/
deploy/
work/
scripts/
docs/
.claude/
.github/

# OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.suo
*.user
*.userosscache
*.sln.docstates

# Node.js & React Build Outputs
web/node_modules/
web/dist/
web/build/
web/test-results/
.expo/

# .NET Build & Publish Outputs
**/bin/
**/obj/
**/.vs/
publish-backend-iis/

# Runtime Logs, Crash Dumps & Scratch Outputs
*.log
*.log.err
hs_err_pid*
replay_pid*
*.csv
*.tmp

# Local Binaries
powershell.cmd
powershell.exe

# Legacy & Scratch Scripts in Root
*.js
*.py
*.sh
*.ps1
